# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js & turbopack
/.next/
/out/
.turbo/

# production
/build

# misc & OS metadata
.DS_Store
*.pem
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
*.tmp

# debug & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo

# typescript
*.tsbuildinfo
next-env.d.ts
